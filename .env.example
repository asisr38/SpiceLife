# Copy to .env. Use fake customer details while testing.
PORT=4173
HOST=127.0.0.1
# Set a long private passphrase (at least 12 characters). Otherwise one is generated at startup.
# STAFF_PASSWORD=
# For phones on the same trusted Wi-Fi, set HOST=0.0.0.0 and PUBLIC_URL to this Mac's LAN URL.
# PUBLIC_URL=http://192.168.1.10:4173
# Set to 1 behind HTTPS when deploying.
# COOKIE_SECURE=1
